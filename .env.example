# BaliGuide Adat — Environment Variables (TEMPLATE)
# Copy to .env and fill with local values. NEVER commit .env to git.
#
# MySQL (Laragon) — scripts/sync_aturan.py
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_adatnusa
MYSQL_BIN=C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysql.exe

# Frontend (Vite) — prefix VITE_ untuk di-expose ke client
VITE_APP_TITLE=BaliGuide Adat
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# API (jika ada di masa depan)
API_BASE_URL=
API_KEY=
